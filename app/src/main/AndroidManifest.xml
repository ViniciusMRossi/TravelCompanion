<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Foreground location only. Walk Mode holds location behind a foreground
        service while a walk runs (D030); nothing in the app requests location
        in the background, so ACCESS_BACKGROUND_LOCATION is not declared. Add
        it back in the phase that implements passive geofencing, not before.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".TravelCompanionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Keeps the process foreground while a walk is running: Android only
            allows location in the background behind a service of this type,
            and that service must show a notification (brief, Location).
        -->
        <service
            android:name=".service.walk.WalkModeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Hosts audioguide playback outside the Activity so audio keeps
            running with the screen off, and so the notification, lock screen
            and headset controls work while the phone is in a pocket.
        -->
        <service
            android:name=".service.playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            Hands one memory's audio file to whatever the traveller picks in the
            system share sheet, and nothing else.

            `memory_file_paths.xml` exposes `files/memories/` alone, never the
            whole `filesDir`, and the read permission is granted per-Intent and
            expires with it. Declared because it is used, on the same terms as
            the permissions this app has removed when they were not (D082).
        -->
        <provider
            android:name=".service.external.MemoryFileProvider"
            android:authorities="${applicationId}.memories"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/memory_file_paths" />
        </provider>

    </application>
</manifest>
