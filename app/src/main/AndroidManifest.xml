<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Walk Mode holds location behind a foreground service while a walk runs
        (D030). Fine location is what a geofence needs too, and what screen 06
        asks for immediately before the walk needs it.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Passive story discovery, and only that. D033 removed this permission
        when it was declared and never exercised, on the promise that it would
        come back in the phase that registered background geofences: this is
        that phase. Three circles in Sarajevo are watched by the system while
        the app is not on screen, so that walking into Baščaršija says
        something without the phone having been taken out.

        Asked separately from the foreground grant, once, and never insisted
        on: from Android 11 the system shows no dialog for it at all, so
        screen 19 points at Android's own settings page and stops asking. A
        refusal costs automatic stories and nothing else — the walk, the audio
        and every story on screen 04 are unchanged (D104).
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Twelve packaged deadlines, each announced at the minute the content
        says to act. `USE_EXACT_ALARM` is the one that needs no asking, and
        Play policy reserves it for alarm clocks and calendars, which this is
        not. So SCHEDULE_EXACT_ALARM, which before Android 13 is granted on
        install and from 13 starts denied — the app reads its state and falls
        back to an inexact alarm rather than prompting through a flow no
        approved sheet draws (D093).

        Declared because it is used, and read before every use. RECEIVE_BOOT_-
        COMPLETED is here for the same reason: Android drops alarms on
        restart and a twenty-day trip goes through restarts.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TravelCompanionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Keeps the process foreground while a walk is running: Android only
            allows location in the background behind a service of this type,
            and that service must show a notification (brief, Location).
        -->
        <service
            android:name=".service.walk.WalkModeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Hosts audioguide playback outside the Activity so audio keeps
            running with the screen off, and so the notification, lock screen
            and headset controls work while the phone is in a pocket.
        -->
        <service
            android:name=".service.playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            Hands one memory's audio file to whatever the traveller picks in the
            system share sheet, and nothing else.

            `memory_file_paths.xml` exposes `files/memories/` alone, never the
            whole `filesDir`, and the read permission is granted per-Intent and
            expires with it. Declared because it is used, on the same terms as
            the permissions this app has removed when they were not (D082).
        -->
        <provider
            android:name=".service.external.MemoryFileProvider"
            android:authorities="${applicationId}.memories"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/memory_file_paths" />
        </provider>

        <!--
            Posts one packaged deadline when its alarm fires. Not exported:
            nothing outside this app has any business ringing it.
        -->
        <receiver
            android:name=".service.notification.CriticalAlertReceiver"
            android:exported="false" />

        <!--
            Where Play Services delivers a geofence transition. Not exported:
            the PendingIntent that carries a transition here is this app's own,
            and nothing outside it has any business waking a story.
        -->
        <receiver
            android:name=".service.location.StoryGeofenceReceiver"
            android:exported="false" />

        <!--
            Puts the deadlines back after a restart or an update (D092), and
            the story geofences with them — Android drops both on boot (D103).
        -->
        <receiver
            android:name=".service.notification.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
