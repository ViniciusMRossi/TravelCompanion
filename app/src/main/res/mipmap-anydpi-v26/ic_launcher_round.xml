<?xml version="1.0" encoding="utf-8"?>
<!--
    The art is a full-bleed square and goes in the background layer on purpose.
    Some launchers apply parallax to the foreground; moving a bleeding image
    would expose the layer behind it along one edge. <foreground> is required by
    AdaptiveIconDrawable, hence the transparent drawable.

    The art was recomposed for this geometry after the first attempt: the
    subject now occupies 63% x 60% of the frame and survives the mask, so the
    bleed costs the blurred corners and nothing else (D122).

    <monochrome> is the themed-icon layer. Its shape lives in the alpha channel,
    including the interior detail lines, so the system tint keeps them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
